{
  "color": {
    "noc": "#0F2E2C",
    "more": "#2F7F7A",
    "pisek": "#F3EBDD",
    "hlina": "#A04E28",
    "olibanum": "#D3A74A",

    "bg": "var(--color-pisek)",
    "text": "var(--color-noc)",
    "primary": "var(--color-hlina)",
    "primaryText": "#FFFFFF",
    "accent": "var(--color-more)",
    "onDark": "var(--color-pisek)",
    "gold": "var(--color-olibanum)",

    "surface": "#FBF7EF",
    "surfaceDark": "#173F3C",
    "muted": "#4A5E5B",
    "mutedOnDark": "#B8C6C1",
    "border": "#DDD2BD",
    "borderOnDark": "#2C5551"
  },
  "font": {
    "body": "'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "heading": "'Fraunces Variable', Georgia, 'Times New Roman', serif"
  },
  "radius": { "sm": "8px", "md": "14px", "lg": "28px", "arch": "999px 999px 20px 20px" },
  "space": { "1": "4px", "2": "8px", "3": "16px", "4": "24px", "5": "48px", "6": "96px" },
  "shadow": { "card": "0 10px 40px rgba(15,46,44,.10)", "lift": "0 18px 50px rgba(15,46,44,.18)" },
  "motion": { "ease": "cubic-bezier(.22,.8,.24,1)", "fast": "180ms", "base": "520ms", "slow": "900ms" }
}
